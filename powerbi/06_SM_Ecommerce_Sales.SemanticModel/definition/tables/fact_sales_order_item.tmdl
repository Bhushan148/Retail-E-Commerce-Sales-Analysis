table fact_sales_order_item
	lineageTag: 1180cb0e-a834-4e84-a0cf-ac8b75fefff4

	refreshPolicy
		policyType: basic
		rollingWindowGranularity: year
		rollingWindowPeriods: 5
		incrementalGranularity: month
		incrementalPeriods: 1
		sourceExpression =
			let
			    Source = Sql.Database("<sql-endpoint-id>.datawarehouse.fabric.microsoft.com", "LH_Ecommerce"),
