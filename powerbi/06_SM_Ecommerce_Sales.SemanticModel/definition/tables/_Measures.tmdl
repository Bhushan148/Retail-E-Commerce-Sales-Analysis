/// All report KPIs live here. Organised into 8 folders: Sales, Profitability, Customers, Order Quality, Year over Year, Time Period, Product, Channel & Region.
table _Measures
	lineageTag: 1a86f2ed-cd9c-4dcb-9673-925810f7a6da

	/// Sum of GrossSalesUSD from fact_sales_order_item. Shown on the top KPI banner (all pages) and as the starting bar in the Revenue to Gross Profit Bridge on the Overview page. Represents gross sales before discounts or returns.
	measure 'Total Revenue' = SUM(fact_sales_order_item[GrossSalesUSD])
		formatString: $#,##0.00
		displayFolder: Sales
		lineageTag: 09d84535-4222-49d2-8e15-03b356cf4c4f

	/// Sum of NetRevenueUSD from fact_sales_order_item. Core revenue figure used in the Sales page trend chart, Overview KPI selector (Revenue option), Region bar chart, Sales by Channel bar, and as the denominator in most margin and share measures.
	measure 'Net Revenue' = SUM(fact_sales_order_item[NetRevenueUSD])
		formatString: $#,##0.00
		displayFolder: Sales
		lineageTag: 991ac14a-7fe4-4915-96d9-840c5f1f928f

	/// Count of distinct OrderID values. Shown on the top KPI banner (all pages) and in the Details page P&L table. Used as the denominator for Average Order Value and rate measures.
	measure 'Total Orders' = DISTINCTCOUNT(fact_sales_order_item[OrderID])
		formatString: #,##0
		displayFolder: Sales
		lineageTag: 9f36e55f-a40d-4db6-a9e3-e53ffd3eb45b

	/// Sum of Quantity from fact_sales_order_item. Shown in the Details page P&L table. Used to compute Avg Units per Order.
	measure 'Total Units Sold' = SUM(fact_sales_order_item[Quantity])
		formatString: #,##0
		displayFolder: Sales
		lineageTag: fa933398-6516-49f6-ab1d-8a074b4bc282

	/// Net Revenue divided by Total Orders. Shown on the top KPI banner (all pages) and in the Details page P&L table. Also available as a KPI Selector option on the Overview page combo chart.
	measure 'Average Order Value' = DIVIDE([Net Revenue], [Total Orders], 0)
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		displayFolder: Sales
		lineageTag: 442708f8-063f-4cf8-ac3d-7a77d2979950

	/// Sum of GrossProfitUSD from fact_sales_order_item (Net Revenue minus Product Cost). Shown on the top KPI banner (all pages), as the final bar in the Revenue Bridge on the Overview page, and in the Details page P&L table.
	measure 'Gross Profit' = SUM(fact_sales_order_item[GrossProfitUSD])
		formatString: $#,##0.00
		displayFolder: Profitability
		lineageTag: 8e568180-05dd-4809-a82e-61ddb4656fe6

	/// Gross Profit divided by Net Revenue. Shown on the Products page left KPI card (via KPIProgressListHTML_) and in the Details page P&L table. Also returned by Selected KPI Value when Profit is selected in the KPI Selector.
	measure 'Gross Profit Margin %' = DIVIDE([Gross Profit], [Net Revenue], 0)
		formatString: 0.00%
		displayFolder: Profitability
		lineageTag: 07c03e2a-60a3-4bb6-8735-6df907beefcf

	/// Total Discount Amount divided by Total Revenue. Shown in the Details page P&L table. Tracks what share of gross sales is given away as discounts.
	measure 'Discount Rate %' = DIVIDE([Total Discount Amount], [Total Revenue], 0)
		formatString: 0.00%
		displayFolder: Sales
		lineageTag: 24661fa9-1343-45a8-a89b-3001f9b952ba

	/// Total Returned Orders divided by Total Orders. Shown in the Details page P&L table. Measures the percentage of orders that came back as returns.
	measure 'Return Rate %' = DIVIDE([Total Returned Orders], [Total Orders], 0)
		formatString: 0.00%
		displayFolder: Order Quality
		lineageTag: acc0966e-422c-4c6d-bf30-827f9bf619a0

	/// Total Cancelled Orders divided by Total Orders. Shown in the Details page P&L table. Tracks the share of orders cancelled before fulfillment.
	measure 'Cancellation Rate %' = DIVIDE([Total Cancelled Orders], [Total Orders], 0)
		formatString: 0.00%
		displayFolder: Order Quality
		lineageTag: 1d90c3e5-4419-4385-a8a4-18ab3d39f620

	/// Total Delivered Orders divided by Total Orders. Shown in the Details page P&L table. Measures how many orders reached the customer successfully.
	measure 'Delivery Rate %' = DIVIDE([Total Delivered Orders], [Total Orders], 0)
		formatString: 0.00%
		displayFolder: Order Quality
		lineageTag: 9f5f0ed5-6950-4acd-ab6a-a50cff620f2a

	/// Count of distinct CustomerKey values in fact_sales_order_item. Shown on the top KPI banner (all pages) and in the Details page P&L table. Also available as a KPI Selector option on the Overview page.
	measure 'Total Customers' = DISTINCTCOUNT(fact_sales_order_item[CustomerKey])
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 2f3777ad-acdd-449f-be75-7495fd0272b6

	/// Distinct customers whose CustomerOrderSequence equals 1 — their very first order. Shown as a KPI card on the Customers page and in the Details page P&L table.
	measure 'New Customers' =
			
			VAR _MinVisibleDate = MIN(dim_date[Date])
			VAR _MaxVisibleDate = MAX(dim_date[Date])
			RETURN
			COUNTROWS(
			    FILTER(
			        VALUES(fact_sales_order_item[CustomerKey]),
			        VAR _FirstOrderDate =
			            CALCULATE(
			                MIN(fact_sales_order_item[OrderDate]),
			                ALL(dim_date)
			            )
			        RETURN
			            NOT ISBLANK(_FirstOrderDate)
			                && _FirstOrderDate >= _MinVisibleDate
			                && _FirstOrderDate <= _MaxVisibleDate
			    )
			)
		formatString: #,##0
		displayFolder: Customers
		lineageTag: c41cf816-c750-4d37-b0f4-da426e1d2eec

	/// Distinct customers where IsRepeatCustomer = 1. Used as the numerator for Repeat Customer Rate % and shown in the Details page P&L table (Returning Customers row).
	measure 'Returning Customers' = CALCULATE(DISTINCTCOUNT(fact_sales_order_item[CustomerKey]), fact_sales_order_item[IsRepeatCustomer] = 1)
		formatString: #,##0
		displayFolder: Customers
		lineageTag: 40aefcf7-ed89-4a4c-9648-7cd6d29b917b

	/// Returning Customers divided by Total Customers. Shown as a KPI card on the Customers page and in the Details page P&L table. Measures how many buyers return for a second purchase.
	measure 'Repeat Customer Rate %' = DIVIDE([Returning Customers], [Total Customers], 0)
		formatString: 0.00%
		displayFolder: Customers
		lineageTag: 1bef89ed-a9db-4957-8610-19fe71b8a9fd

	/// Estimated lifetime revenue per customer: Average Order Value × Purchase Frequency × Avg Lifespan in years. Shown as a KPI card on the Customers page and in the Details page P&L table. Lifespan is calculated across ALL(dim_date) so it is filter-independent.
	measure 'Customer Lifetime Value' =
			VAR _MinDate = CALCULATE(MIN(fact_sales_order_item[OrderDate]), ALL(dim_date))
			VAR _MaxDate = CALCULATE(MAX(fact_sales_order_item[OrderDate]), ALL(dim_date))
			VAR AvgLifespanYrs =
			    DIVIDE(
			        DATEDIFF(_MinDate, _MaxDate, MONTH),
			        12, 0
			    )
			VAR PurchaseFreq = DIVIDE([Total Orders], [Total Customers], 0)
			RETURN
			    [Average Order Value] * PurchaseFreq * AvgLifespanYrs
		formatString: $#,##0.00
		displayFolder: Customers
		lineageTag: ac16ba5b-8029-46da-bc11-c7644307b50e

	/// Net Revenue change vs the previous calendar month using DATEADD(-1, MONTH). Shown in the MoM badge on the Total Revenue KPI HTML card (all pages). Also returned by Selected KPI MoM % when Revenue is selected on the Overview page.
	measure 'Revenue MoM %' =
			VAR CurrentRevenue = [Net Revenue]
			VAR PriorMonthRevenue =
			    CALCULATE(
			        [Net Revenue],
			        DATEADD(dim_date[Date], -1, MONTH)
			    )
			RETURN
			    DIVIDE(CurrentRevenue - PriorMonthRevenue, PriorMonthRevenue, BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: fe5ce91a-09a5-40f6-80ef-7b5761b5b2ef

	/// Net Revenue change vs the same period last year using Net Revenue LY. Shown in the YoY badge on the Total Revenue KPI HTML card (all pages). Also returned by Selected KPI YoY % when Revenue is selected on the Overview page.
	measure 'Revenue YoY %' = DIVIDE([Net Revenue] - [Net Revenue LY], [Net Revenue LY], BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 86739fa4-9ce5-4a2d-83f3-48c1c160fef1

	/// Net Revenue for the current row divided by total Net Revenue across all products, geographies, and customers. Shown in the Product Performance Detail table on the Products page (Revenue Contribution % column).
	measure 'Revenue Contribution %' =
			DIVIDE(
			    [Net Revenue],
			    CALCULATE([Net Revenue], ALL(dim_product), ALL(dim_geography), ALL(dim_customer)),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Products
		lineageTag: 32ed7585-d272-4df2-9f1a-cc384b13e497

	/// Total Orders change vs the same period last year. Shown in the YoY badge on the Total Orders KPI HTML card (all pages). Also returned by Selected KPI YoY % when Orders is selected on the Overview page.
	measure 'Orders YoY %' = DIVIDE([Total Orders] - [Total Orders LY], [Total Orders LY], BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 11b6c9f0-c6f7-4dd7-922c-f781086b9c42

	/// Total Customers change vs the same period last year. Shown in the YoY badge on the Total Customers KPI HTML card (all pages). Also returned by Selected KPI YoY % when Customers is selected on the Overview page.
	measure 'Customers YoY %' = DIVIDE([Total Customers] - [Total Customers LY], [Total Customers LY], BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 0780c8f5-8500-464e-b83b-1aa022b1760a

	/// Sum of DiscountUSD from fact_sales_order_item. Used in the Revenue to Gross Profit Bridge on the Overview page (Discounts bar) and in the Details page P&L table (Discounts Applied row).
	measure 'Total Discount Amount' = SUM(fact_sales_order_item[DiscountUSD])
		formatString: $#,##0.00
		displayFolder: Sales
		lineageTag: e54b0bb7-a9a1-49e3-9683-f17b0c0a5d2d

	/// Total Units Sold divided by Total Orders. Shown in the Details page P&L table. Indicates how many product units a typical order contains.
	measure 'Avg Units per Order' = DIVIDE([Total Units Sold], [Total Orders], 0)
		formatString: 0.00
		displayFolder: Sales
		lineageTag: 11653045-d422-4d0a-9299-c841d41d5632

	/// Gross Profit change vs the same period last year using Gross Profit LY. Shown in the YoY badge on the Gross Profit KPI HTML card (all pages). Also returned by Selected KPI YoY % when Profit is selected on the Overview page.
	measure 'Gross Profit YoY %' = DIVIDE([Gross Profit] - [Gross Profit LY], [Gross Profit LY], BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 3ca60655-b031-4b9a-8894-7052cf5983c6

	/// Sum of ReturnAmountUSD from fact_sales_order_item. Used in the Revenue to Gross Profit Bridge on the Overview page (Returns bar) and in the Details page P&L table (Returns & Refunds row).
	measure 'Total Return Revenue Loss' = SUM(fact_sales_order_item[ReturnAmountUSD])
		formatString: $#,##0.00
		displayFolder: Profitability
		lineageTag: 302fc3b8-dfe0-4ad0-af0c-9222854b07c0

	/// Count of distinct OrderIDs where IsDelivered = 1. Used in the Revenue by Order Status chart on the Sales page and in the Details page P&L table (Delivery Rate % denominator).
	measure 'Total Delivered Orders' = CALCULATE(DISTINCTCOUNT(fact_sales_order_item[OrderID]), fact_sales_order_item[IsDelivered] = 1)
		formatString: #,##0
		displayFolder: Order Quality
		lineageTag: 826287a4-39f1-47db-a203-ebf1cb76b599

	/// Count of distinct OrderIDs where IsReturned = 1. Used in the Revenue by Order Status chart on the Sales page and as the numerator for Return Rate % in the Details page P&L table.
	measure 'Total Returned Orders' = CALCULATE(DISTINCTCOUNT(fact_sales_order_item[OrderID]), fact_sales_order_item[IsReturned] = 1)
		formatString: #,##0
		displayFolder: Order Quality
		lineageTag: baa5e45e-3a34-4344-998e-43f963a68496

	/// Count of distinct OrderIDs where IsCancelled = 1. Used in the Revenue by Order Status chart on the Sales page and as the numerator for Cancellation Rate % in the Details page P&L table.
	measure 'Total Cancelled Orders' = CALCULATE(DISTINCTCOUNT(fact_sales_order_item[OrderID]), fact_sales_order_item[IsCancelled] = 1)
		formatString: #,##0
		displayFolder: Order Quality
		lineageTag: f1a8c37e-4e6b-49b6-9617-9325feb8f57d

	/// Average Order Value change vs the same period last year using AOV LY. Shown in the YoY badge on the Average Order Value KPI HTML card (all pages). Also returned by Selected KPI YoY % when AOV is selected on the Overview page.
	measure 'Avg Order Value YoY %' = DIVIDE([Average Order Value] - [AOV LY], [AOV LY], BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 368878f4-7747-4f49-b99a-7bc72f1ac031

	/// Count of distinct ProductKeys where dim_product[IsActive] = 1. Shown on the Products page left KPI card (via KPIProgressListHTML_ measure). Represents the live catalogue size.
	measure 'Total Active Products' = CALCULATE(DISTINCTCOUNT(dim_product[ProductKey]), dim_product[IsActive] = 1)
		formatString: #,##0
		displayFolder: Products
		lineageTag: 207cd95e-564c-47fd-8ce5-21c8fc5a365d

	/// Net Revenue divided by distinct count of SKUs. Shown on the Products page left KPI card (via KPIProgressListHTML_ measure). Tracks average revenue generated per individual SKU.
	measure 'Product Revenue per SKU' = DIVIDE([Net Revenue], DISTINCTCOUNT(dim_product[SKU]), 0)
		formatString: $#,##0.00
		displayFolder: Products
		lineageTag: 8d134ede-ab37-4ff2-8e7f-a83d3d496121

	/// Net Revenue minus Net Revenue LY — the absolute dollar difference year over year. Available as a tooltip or supplementary metric. Positive means growth vs the same period last year.
	measure 'Revenue Variance vs LY $' = [Net Revenue] - [Net Revenue LY]
		formatString: $#,##0.00
		displayFolder: Sales
		lineageTag: cb2227dc-4c9f-4845-925a-3c5adfa7ebeb

	/// Orders minus Cancelled Orders divided by Total Orders. Shown in the Details page P&L table. Measures share of orders that entered fulfillment.
	measure 'Fulfillment Rate %' = DIVIDE([Total Orders] - [Total Cancelled Orders], [Total Orders], 0)
		formatString: 0.00%
		displayFolder: Order Quality
		lineageTag: 6b083cdf-41b1-4885-aa60-d7f34d2d2f2f

	/// Gross Profit for the same period last year. Used as the LY benchmark in the Gross Profit KPI HTML card and as the denominator in Gross Profit YoY %. Also returned by Selected KPI LY when Profit is selected.
	measure 'Gross Profit LY' = CALCULATE([Gross Profit], DATEADD(dim_date[Date], -1, YEAR))
		formatString: $#,##0.00
		displayFolder: Profitability
		lineageTag: 45cadbaf-cfec-4c45-b178-4611934d3da1

	/// Total Orders change vs the previous calendar month. Shown in the MoM badge on the Total Orders KPI HTML card (all pages). Also returned by Selected KPI MoM % when Orders is selected on the Overview page.
	measure 'Orders MoM %' =
			VAR CurrOrders = [Total Orders]
			VAR PriorMonthOrders = CALCULATE([Total Orders], DATEADD(dim_date[Date], -1, MONTH))
			RETURN DIVIDE(CurrOrders - PriorMonthOrders, PriorMonthOrders, BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: cbd06196-540b-4946-92b9-009223c210cd

	/// Total Customers change vs the previous calendar month. Shown in the MoM badge on the Total Customers KPI HTML card and in the Customer Growth & Retention Trend bar chart on the Customers page. Also returned by Selected KPI MoM % when Customers is selected.
	measure 'Customers MoM %' =
			VAR CurrCust = [Total Customers]
			VAR PriorMonthCust = CALCULATE([Total Customers], DATEADD(dim_date[Date], -1, MONTH))
			RETURN DIVIDE(CurrCust - PriorMonthCust, PriorMonthCust, BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 7f60dd20-ec35-45ea-9e26-59df2f6ab674

	/// Gross Profit change vs the previous calendar month. Shown in the MoM badge on the Gross Profit KPI HTML card (all pages). Also returned by Selected KPI MoM % when Profit is selected on the Overview page.
	measure 'Gross Profit MoM %' =
			VAR CurrGP = [Gross Profit]
			VAR PriorMonthGP = CALCULATE([Gross Profit], DATEADD(dim_date[Date], -1, MONTH))
			RETURN DIVIDE(CurrGP - PriorMonthGP, PriorMonthGP, BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 77d56e7a-e833-4dc9-ae2c-bf50b292d08e

	/// Average Order Value change vs the previous calendar month. Shown in the MoM badge on the Average Order Value KPI HTML card (all pages). Also returned by Selected KPI MoM % when AOV is selected on the Overview page.
	measure 'AOV MoM %' =
			VAR CurrAOV = [Average Order Value]
			VAR PriorMonthAOV = CALCULATE([Average Order Value], DATEADD(dim_date[Date], -1, MONTH))
			RETURN DIVIDE(CurrAOV - PriorMonthAOV, PriorMonthAOV, BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Time Intelligence
		lineageTag: 7da13780-abb2-4a03-b1a0-daa13e7b84a8

	/// Net Revenue for the exact same period one year ago using DATEADD(-1, YEAR). Used as the LY benchmark in the KPI HTML cards (all pages), returned by Selected KPI LY when Revenue is selected, and shown in the Product Performance Detail table (Net Revenue LY column).
	measure 'Net Revenue LY' = CALCULATE([Net Revenue], DATEADD(dim_date[Date], -1, YEAR))
		formatString: $#,##0.00
		displayFolder: Time Intelligence
		lineageTag: dda4a11b-1761-454f-8954-980da5698266

	/// Total Orders for the same period last year. Used as the LY benchmark in the Total Orders KPI HTML card and returned by Selected KPI LY when Orders is selected on the Overview page.
	measure 'Total Orders LY' = CALCULATE([Total Orders], DATEADD(dim_date[Date], -1, YEAR))
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: 4a12c9e3-32f6-4117-b620-f3b0fbbe9ce3

	/// Total Customers for the same period last year. Used as the LY benchmark in the Total Customers KPI HTML card and returned by Selected KPI LY when Customers is selected on the Overview page.
	measure 'Total Customers LY' = CALCULATE([Total Customers], DATEADD(dim_date[Date], -1, YEAR))
		formatString: #,##0
		displayFolder: Time Intelligence
		lineageTag: be380295-b618-42b6-b91c-c3383e91aff5

	/// Average Order Value for the same period last year. Used as the LY benchmark in the Average Order Value KPI HTML card and as the denominator in Avg Order Value YoY %. Also returned by Selected KPI LY when AOV is selected.
	measure 'AOV LY' = CALCULATE([Average Order Value], DATEADD(dim_date[Date], -1, YEAR))
		formatString: $#,##0.00
		displayFolder: Time Intelligence
		lineageTag: a7a84c6c-df32-430c-bc7a-2d3a472ad402

	/// SWITCH on the KPI Selector slicer selection (Overview page). Returns Net Revenue, Total Orders, Total Customers, Gross Profit, or Average Order Value. Used as the bar/column value in the Monthly Revenue with Growth % combo chart on the Overview page.
	measure 'Selected KPI Value' =
			VAR SelectedMetric = SELECTEDVALUE('KPI Selector'[KPI Selector], "Net Revenue")
			RETURN
			SWITCH(
			    SelectedMetric,
			    "Net Revenue",      [Net Revenue],
			    "Total Orders",     [Total Orders],
			    "Total Customers",  [Total Customers],
			    "Gross Profit",     [Gross Profit],
			    "Avg Order Value",  [Average Order Value],
			    [Net Revenue]
			)
		displayFolder: Field Parameters
		lineageTag: a3f0961d-59da-48ee-964c-060e7c549bed

	/// SWITCH on the KPI Selector slicer selection. Returns the YoY % for whichever KPI is active. Used as the line value in the Monthly Revenue with Growth % combo chart on the Overview page, showing year-over-year trend for the selected metric.
	measure 'Selected KPI YoY %' =
			VAR SelectedMetric = SELECTEDVALUE('KPI Selector'[KPI Selector], "Net Revenue")
			RETURN
			SWITCH(
			    SelectedMetric,
			    "Net Revenue",      [Revenue YoY %],
			    "Total Orders",     [Orders YoY %],
			    "Total Customers",  [Customers YoY %],
			    "Gross Profit",     [Gross Profit YoY %],
			    "Avg Order Value",  [Avg Order Value YoY %],
			    [Revenue YoY %]
			)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Field Parameters
		lineageTag: f1b1938a-db7b-4868-b384-553ec05d3020

	/// SWITCH on the KPI Selector slicer selection. Returns the MoM % for whichever KPI is active. Available as a supplementary metric on the Overview page combo chart for month-over-month trend of the selected KPI.
	measure 'Selected KPI MoM %' =
			VAR SelectedMetric = SELECTEDVALUE('KPI Selector'[KPI Selector], "Net Revenue")
			RETURN
			SWITCH(
			    SelectedMetric,
			    "Net Revenue",      [Revenue MoM %],
			    "Total Orders",     [Orders MoM %],
			    "Total Customers",  [Customers MoM %],
			    "Gross Profit",     [Gross Profit MoM %],
			    "Avg Order Value",  [AOV MoM %],
			    [Revenue MoM %]
			)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Field Parameters
		lineageTag: 17b898f8-b55a-49f7-8eab-95a6722a6498

	/// SWITCH on the KPI Selector slicer selection. Returns the prior-year value (LY) for whichever KPI is selected. Used as the Target value on KPI visual cards so the directional arrow and variance display correctly.
	measure 'Selected KPI LY' =
			VAR SelectedMetric = SELECTEDVALUE('KPI Selector'[KPI Selector], "Net Revenue")
			RETURN
			SWITCH(
			    SelectedMetric,
			    "Net Revenue",      [Net Revenue LY],
			    "Total Orders",     [Total Orders LY],
			    "Total Customers",  [Total Customers LY],
			    "Gross Profit",     [Gross Profit LY],
			    "Avg Order Value",  [AOV LY],
			    [Net Revenue LY]
			)
		displayFolder: Field Parameters
		lineageTag: cc8d341b-f4a9-4a08-8d58-ca556124737f

	/// Returns the display label text for the selected KPI (e.g. 'Net Revenue', 'Total Orders'). Used as a dynamic title in the Overview page combo chart heading so the chart title updates when a different KPI is selected.
	measure 'KPI Card Title' =
			VAR SelectedMetric = SELECTEDVALUE('KPI Selector'[KPI Selector], "Net Revenue")
			RETURN
			SWITCH(
			    SelectedMetric,
			    "Net Revenue",     "Net Revenue",
			    "Total Orders",    "Total Orders",
			    "Total Customers", "Total Customers",
			    "Gross Profit",    "Gross Profit",
			    "Avg Order Value", "Avg Order Value",
			    "Net Revenue"
			)
		displayFolder: Field Parameters
		lineageTag: d361de5f-9fe6-4c63-b372-d2b1dca70efe

	/// SWITCH on the _Detail Rows[Row Label] column. Returns the correct current-period value for each row in the Financial Performance Details matrix on the Details page. Drop as the Values field in the matrix with _Detail Rows[Row Label] as rows and dim_date[Year] as columns.
	measure 'P&L Statement Value' =
			VAR RowLabel = SELECTEDVALUE('_Detail Rows'[Row Label], "Net Revenue")
			RETURN
			SWITCH(
			    RowLabel,
			    "Gross Sales Revenue",    [Total Revenue],
			    "(-) Discounts Applied",  [Total Discount Amount],
			    "(-) Returns & Refunds",  [Total Return Revenue Loss],
			    "= Net Revenue",          [Net Revenue],
			    "(-) Product Cost",       [Total Product Cost],
			    "= Gross Profit",         [Gross Profit],
			    "Gross Profit Margin %",  [Gross Profit Margin %],
			    "Discount Rate %",        [Discount Rate %],
			    "Total Orders",           [Total Orders],
			    "Average Order Value",    [Average Order Value],
			    "Total Units Sold",       [Total Units Sold],
			    "Avg Units per Order",    [Avg Units per Order],
			    "Total Customers",        [Total Customers],
			    "New Customers",          [New Customers],
			    "Returning Customers",    [Returning Customers],
			    "Repeat Customer Rate %", [Repeat Customer Rate %],
			    "Customer Lifetime Value",[Customer Lifetime Value],
			    "Delivery Rate %",        [Delivery Rate %],
			    "Return Rate %",          [Return Rate %],
			    "Cancellation Rate %",    [Cancellation Rate %],
			    "Fulfillment Rate %",     [Fulfillment Rate %],
			    [Net Revenue]
			)
		displayFolder: Visuals & HTML
		lineageTag: ec82e8e7-3762-4a11-a9c0-2065a504c776

	/// SWITCH on _Detail Rows[Row Label]. Returns the YoY % change for each row in the Financial Performance Details matrix on the Details page. Used as a second Values field alongside P&L Statement Value to show current vs prior year growth.
	measure 'P&L YoY Change' =
			VAR RowLabel = SELECTEDVALUE('_Detail Rows'[Row Label], "Net Revenue")
			VAR CurrVal =
			    SWITCH(
			        RowLabel,
			        "Gross Sales Revenue",    [Total Revenue],
			        "(-) Discounts Applied",  [Total Discount Amount],
			        "(-) Returns & Refunds",  [Total Return Revenue Loss],
			        "= Net Revenue",          [Net Revenue],
			        "(-) Product Cost",       [Total Product Cost],
			        "= Gross Profit",         [Gross Profit],
			        "Gross Profit Margin %",  [Gross Profit Margin %],
			        "Discount Rate %",        [Discount Rate %],
			        "Total Orders",           [Total Orders],
			        "Average Order Value",    [Average Order Value],
			        "Total Units Sold",       [Total Units Sold],
			        "Avg Units per Order",    [Avg Units per Order],
			        "Total Customers",        [Total Customers],
			        "New Customers",          [New Customers],
			        "Returning Customers",    [Returning Customers],
			        "Repeat Customer Rate %", [Repeat Customer Rate %],
			        "Customer Lifetime Value",[Customer Lifetime Value],
			        "Delivery Rate %",        [Delivery Rate %],
			        "Return Rate %",          [Return Rate %],
			        "Cancellation Rate %",    [Cancellation Rate %],
			        "Fulfillment Rate %",     [Fulfillment Rate %],
			        [Net Revenue]
			    )
			VAR PriorVal = CALCULATE(CurrVal, DATEADD(dim_date[Date], -1, YEAR))
			RETURN DIVIDE(CurrVal - PriorVal, ABS(PriorVal), BLANK())
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Visuals & HTML
		lineageTag: 70ad2243-52be-4ded-8c82-57ccc9c64a92

	/// SWITCH on _Detail Rows[Row Label]. Returns the prior-year value for each row in the Financial Performance Details matrix on the Details page. Shown in the LY column of the Financial Performance Details table.
	measure 'P&L Statement Value (LY)' =
			VAR RowLabel = SELECTEDVALUE('_Detail Rows'[Row Label], "Net Revenue")
			VAR CurrVal =
			    SWITCH(
			        RowLabel,
			        "Gross Sales Revenue",    [Total Revenue],
			        "(-) Discounts Applied",  [Total Discount Amount],
			        "(-) Returns & Refunds",  [Total Return Revenue Loss],
			        "= Net Revenue",          [Net Revenue],
			        "(-) Product Cost",       [Total Product Cost],
			        "= Gross Profit",         [Gross Profit],
			        "Gross Profit Margin %",  [Gross Profit Margin %],
			        "Discount Rate %",        [Discount Rate %],
			        "Total Orders",           [Total Orders],
			        "Average Order Value",    [Average Order Value],
			        "Total Units Sold",       [Total Units Sold],
			        "Avg Units per Order",    [Avg Units per Order],
			        "Total Customers",        [Total Customers],
			        "New Customers",          [New Customers],
			        "Returning Customers",    [Returning Customers],
			        "Repeat Customer Rate %", [Repeat Customer Rate %],
			        "Customer Lifetime Value",[Customer Lifetime Value],
			        "Delivery Rate %",        [Delivery Rate %],
			        "Return Rate %",          [Return Rate %],
			        "Cancellation Rate %",    [Cancellation Rate %],
			        "Fulfillment Rate %",     [Fulfillment Rate %],
			        [Net Revenue]
			    )
			RETURN CALCULATE(CurrVal, DATEADD(dim_date[Date], -1, YEAR))
		displayFolder: Visuals & HTML
		lineageTag: c32af9c9-9ef5-4c96-ae2d-277500c8e95d

	/// Plain-text one-line summary for Total Revenue: shows MoM arrow + % and YoY arrow + %. Use as a subtitle text label below a card visual or tooltip value instead of the full HTML card when a simpler display is needed.
	measure 'Total Revenue KPI Line' =
			
			VAR MoM = [Revenue MoM %]
			VAR YoY = [Revenue YoY %]
			VAR MoMArrow = IF(MoM >= 0, "▲", "▼")
			VAR YoYArrow = IF(YoY >= 0, "▲", "▼")
			RETURN
			MoMArrow & " " & FORMAT(ABS(MoM), "0.0%") & " MoM   |   " &
			YoYArrow & " " & FORMAT(ABS(YoY), "0.0%") & " YoY"
		displayFolder: Visuals & HTML
		lineageTag: c582dde3-a855-406c-a29f-6f44efd3bb60

	/// Self-contained HTML card for Total Revenue. Displayed on all report pages in the top KPI banner strip. Shows the formatted value with orange top accent, MoM badge, and YoY badge in colour-coded arrows.
	measure 'Total Revenue KPI HTML' =
			
			VAR Curr = [Total Revenue]
			VAR MoM = [Revenue MoM %]
			VAR YoY = [Revenue YoY %]
			
			VAR CurrFormatted =
			    SWITCH(
			        TRUE(),
			        ABS(Curr) >= 1000000000, "$" & FORMAT(DIVIDE(Curr, 1000000000), "0.00") & "B",
			        ABS(Curr) >= 1000000,    "$" & FORMAT(DIVIDE(Curr, 1000000), "0.00") & "M",
			        ABS(Curr) >= 1000,       "$" & FORMAT(DIVIDE(Curr, 1000), "0.00") & "K",
			        "$" & FORMAT(Curr, "#,0")
			    )
			
			VAR MoMArrow =
			    IF(MoM >= 0, "▲", "▼")
			
			VAR YoYArrow =
			    IF(YoY >= 0, "▲", "▼")
			
			VAR MoMColor =
			    IF(MoM >= 0, "#22c55e", "#ef4444")
			
			VAR YoYColor =
			    IF(YoY >= 0, "#22c55e", "#ef4444")
			
			VAR MoMText =
			    IF(
			        ISBLANK(MoM),
			        "NA",
			        MoMArrow & " " & FORMAT(ABS(MoM), "0.0%") & " MoM"
			    )
			
			VAR YoYText =
			    IF(
			        ISBLANK(YoY),
			        "NA",
			        YoYArrow & " " & FORMAT(ABS(YoY), "0.0%") & " YoY"
			    )
			
			RETURN
			"
			<div style='
			    width:210px;
			    padding:0;
			    border-radius:8px;
			    background:#232F3E;
			    font-family:Segoe UI, Arial, sans-serif;
			    overflow:hidden;
			    text-align:center;
			'>
			    <div style='
			        height:6px;
			        width:100%;
			        background:#E66C37;
			    '></div>
			
			    <div style='
			        padding:12px 14px;
			    '>
			        <div style='
			            font-size:14px;
			            color:#cbd5e1;
			            font-weight:600;
			            letter-spacing:0.2px;
			            margin-bottom:4px;
			            line-height:1.2;
			            text-align:center;
			        '>
			            Total Revenue
			        </div>
			
			        <div style='
			            font-size:26px;
			            font-weight:700;
			            color:#ffffff;
			            line-height:1.05;
			            margin-bottom:8px;
			            text-align:center;
			        '>
			            " & CurrFormatted & "
			        </div>
			
			        <div style='
			            display:flex;
			            align-items:center;
			            justify-content:center;
			            gap:6px;
			            font-size:12px;
			            font-weight:700;
			            border-top:1px solid rgba(255,255,255,0.10);
			            padding-top:8px;
			            line-height:1.2;
			            text-align:center;
			        '>
			            <div style='color:" & MoMColor & "; white-space:nowrap; text-align:center;'>
			                " & MoMText & "
			            </div>
			
			            <div style='color:#94a3b8; text-align:center;'>|</div>
			
			            <div style='color:" & YoYColor & "; white-space:nowrap; text-align:center;'>
			                " & YoYText & "
			            </div>
			        </div>
			    </div>
			</div>
			"
		displayFolder: Visuals & HTML
		lineageTag: 558f86d3-a8dd-43e0-9347-1dc2fdb5a727

	/// Sum of ProductCostUSD from fact_sales_order_item. Used in the Revenue to Gross Profit Bridge on the Overview page (Product Cost bar) and in the Details page P&L table (Product Cost row).
